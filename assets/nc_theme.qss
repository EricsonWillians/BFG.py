/* ===== BFG.py — REFINED DOOM THEME =====
   Dark, layered surfaces · warm off-white text · one hellfire accent.
   Identity kept: near-black reds, monospace, skull. Yellow-on-navy is gone. */

/* ---------- palette ----------
   bg window   #131015   panel #1B171D   input #0E0C10   raised #241E26
   text        #E9E1D6   muted #A99C90   faint #7A6E64
   accent      #C43B1D   accent+ #E25822 ember #E8A33D   border #383038 */

QWidget {
    background-color: #131015;
    color: #E9E1D6;
    font-family: "Iosevka Nerd Font Mono", "JetBrains Mono", "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 10.5pt;
}

QMainWindow {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #171218, stop:0.55 #131015, stop:1 #0D0B0F);
}
QMainWindow > QWidget { background: transparent; }

/* ---------- inputs, lists, trees ---------- */
QLineEdit, QListWidget, QTreeWidget, QPlainTextEdit, QComboBox {
    background-color: #0E0C10;
    color: #E9E1D6;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 6px 7px;
    selection-background-color: #5A1E12;
    selection-color: #FFE9DC;
    font-size: 10pt;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 1px solid #C43B1D;
}
QLineEdit:disabled, QTreeWidget:disabled, QPlainTextEdit:disabled {
    background-color: #171419;
    color: #7A6E64;
    border-color: #2A252C;
}

QComboBox::drop-down {
    border-left: 1px solid #383038;
    width: 22px;
    background: #241E26;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QComboBox QAbstractItemView {
    background: #171419;
    color: #E9E1D6;
    border: 1px solid #383038;
    selection-background-color: #5A1E12;
    selection-color: #FFE9DC;
}

QListWidget {
    alternate-background-color: #161218;
    outline: none;
}
QListWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #231E26;
    min-height: 18px;
}
QListWidget::item:hover { background-color: #1F1A23; color: #FFFFFF; }
QListWidget::item:selected { background-color: #5A1E12; color: #FFE9DC; }

/* Tree views need every palette role defined explicitly — desktop themes
   otherwise inject a white row while our foreground stays active. */
QTreeWidget {
    background-color: #100D13;
    alternate-background-color: #16121A;
    color: #EDE4D8;
    selection-background-color: #5A1E12;
    selection-color: #FFE9DC;
    border: 1px solid #383038;
    border-radius: 4px;
    outline: none;
}
QTreeWidget::item {
    color: #EDE4D8;
    border-bottom: 1px solid #1F1A23;
    padding: 5px 6px;
    min-height: 22px;
}
QTreeWidget::item:hover:!selected {
    background-color: #211A26;
    color: #FFFFFF;
    border-bottom-color: #C43B1D;
}
QTreeWidget::item:selected:active {
    background-color: #5A1E12;
    color: #FFE9DC;
    border-top: 1px solid #C43B1D;
    border-bottom: 1px solid #C43B1D;
}
QTreeWidget::item:selected:!active {
    background-color: #3A2030;
    color: #FFE9DC;
    border-top: 1px solid #6E4A58;
    border-bottom: 1px solid #6E4A58;
}
QTreeWidget:disabled {
    background-color: #141117;
    alternate-background-color: #181419;
    color: #7A6E64;
    border-color: #2A252C;
}
QTreeWidget::item:disabled { color: #7A6E64; }

QTreeWidget#downloadResults, QTreeWidget#modLibrary {
    background-color: #100D13;
    alternate-background-color: #16121A;
    color: #EDE4D8;
    font-size: 10pt;
}

/* ---------- buttons ---------- */
QPushButton {
    background-color: #241E26;
    color: #E9E1D6;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 6px 12px;
    margin: 1px;
    min-height: 20px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #2E2630;
    border-color: #4A3F46;
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: #5A1E12;
    border-color: #C43B1D;
}
QPushButton:disabled {
    background-color: #1A161C;
    color: #7A6E64;
    border-color: #2A252C;
}
QPushButton#primaryButton {
    background-color: #8C2A12;
    color: #FFE9DC;
    border: 1px solid #C43B1D;
}
QPushButton#primaryButton:hover {
    background-color: #A83418;
    border-color: #E25822;
    color: #FFFFFF;
}
QPushButton#dangerButton {
    background-color: #3A1210;
    color: #F0B9A8;
    border: 1px solid #6E2318;
}
QPushButton#dangerButton:hover {
    background-color: #521A14;
    color: #FFD9CC;
}

/* Launch button: the single loud element — full accent. */
QPushButton#launchButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #D64720, stop:0.55 #B73615, stop:1 #8C2A12);
    color: #FFF3E8;
    border: 1px solid #E25822;
    border-radius: 5px;
    padding: 12px 20px;
    font-family: "Iosevka Nerd Font Mono", "JetBrains Mono", "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 14pt;
    font-weight: bold;
    min-height: 40px;
}
QPushButton#launchButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #E85426, stop:0.55 #C43B1D, stop:1 #9C3011);
    color: #FFFFFF;
}
QPushButton#launchButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #8C2A12, stop:0.55 #B73615, stop:1 #D64720);
}
QPushButton#launchButton:disabled {
    background: #2A2226;
    color: #7A6E64;
    border-color: #383038;
}

/* ---------- menus, tabs, splitter, headers ---------- */
QMenuBar {
    background-color: #171318;
    color: #E9E1D6;
    border-bottom: 1px solid #2A252C;
}
QMenuBar::item:selected { background: #2E2630; border-radius: 3px; }
QMenu {
    background-color: #171419;
    color: #E9E1D6;
    border: 1px solid #383038;
}
QMenu::item { padding: 5px 22px; }
QMenu::item:selected {
    background-color: #5A1E12;
    color: #FFE9DC;
}

QTabWidget::pane {
    border: 1px solid #383038;
    background: #161218;
    border-radius: 4px;
}
QTabBar::tab {
    background: #1B171D;
    color: #A99C90;
    border: 1px solid #383038;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 14px;
    min-width: 80px;
    font-weight: bold;
}
QTabBar::tab:hover { color: #E9E1D6; }
QTabBar::tab:selected {
    background: #241E26;
    color: #FFE9DC;
    border-top: 2px solid #C43B1D;
}

QSplitter::handle {
    background: #241E26;
    width: 4px;
    height: 4px;
}
QSplitter::handle:hover { background: #C43B1D; }

QHeaderView::section {
    background-color: #1B171D;
    color: #C9BFB4;
    border: none;
    border-bottom: 1px solid #383038;
    border-right: 1px solid #2A252C;
    font-weight: bold;
    padding: 5px 6px;
}
QTableCornerButton::section {
    background-color: #1B171D;
    border-bottom: 1px solid #383038;
}

/* ---------- progress & scrollbars ---------- */
QProgressBar {
    background-color: #0E0C10;
    color: #E9E1D6;
    border: 1px solid #383038;
    border-radius: 4px;
    text-align: center;
    height: 20px;
}
QProgressBar::chunk {
    background-color: #C43B1D;
    border-radius: 3px;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #131015;
    border: none;
    width: 12px;
    height: 12px;
    margin: 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #3A3238;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover { background: #C43B1D; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; background: none; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QPlainTextEdit#doomModInfo QScrollBar::handle:vertical { background: #5A1E12; }
QPlainTextEdit#doomModInfo QScrollBar::handle:hover { background: #C43B1D; }

/* ---------- named surfaces ---------- */
QLabel#terminalTitle {
    background: transparent;
    color: #E25822;
    border: none;
    padding: 2px;
    font-size: 12pt;
    font-weight: bold;
}
QLabel#mutedHint {
    color: #A99C90;
    font-size: 10pt;
    padding: 2px;
}
QLabel#readinessStrip {
    background: transparent;
    color: #E8A33D;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}
QLabel#readinessStrip[ready="true"] {
    background: transparent;
    color: #7FB069;
    border: 1px solid #3A4A34;
}
QLabel#modCount {
    background: #1B171D;
    color: #C9BFB4;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 4px 8px;
    font-weight: bold;
}
QLabel#selectionBanner {
    background: #1B171D;
    color: #A99C90;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 5px 8px;
    font-weight: bold;
}
QLabel#selectionBanner[active="true"] {
    background: #241E26;
    color: #FFE9DC;
    border: 1px solid #C43B1D;
}
QPlainTextEdit#browserPreview {
    background: #0E0C10;
    color: #D8CFC3;
    border: 1px solid #383038;
    border-radius: 4px;
    padding: 8px;
    font-size: 9pt;
}
QScrollArea {
    background: transparent;
    border: none;
}
QStatusBar {
    background: #100D12;
    color: #C9BFB4;
    border-top: 1px solid #2A252C;
    padding: 3px;
}

/* ---------- lost soul (identity pieces) ---------- */
QWidget#bloodyContainer {
    background: #8C2A12;
    border: 4px solid #C43B1D;
    border-radius: 14px;
}
QLabel#lostSoul {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
QDialog#lostSoulWindow {
    background-color: #131015;
    border: 1px solid #C43B1D;
    border-radius: 10px;
    padding: 18px;
}
QDialog#lostSoulWindow QProgressBar::chunk { background-color: #C43B1D; }

/* ---------- group boxes: thin rule, quiet title ---------- */
QGroupBox {
    border: 1px solid #2E2830;
    border-radius: 5px;
    margin-top: 14px;
    margin-bottom: 4px;
    background: #181419;
    color: #A99C90;
    font-weight: bold;
    font-size: 9pt;
    padding-top: 14px;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 1px 6px;
    background: transparent;
    color: #A99C90;
    left: 8px;
    top: -6px;
    font-size: 9pt;
}

/* ---------- mod info panel ---------- */
QTextEdit#doomModInfo, QPlainTextEdit#doomModInfo {
    background-color: #1A1210;
    color: #F0D9C8;
    font-family: "Iosevka Nerd Font Mono", "JetBrains Mono", "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 10pt;
    border: 1px solid #4A241C;
    border-radius: 4px;
    padding: 10px;
    selection-background-color: #5A1E12;
    selection-color: #FFE9DC;
}
QTextEdit#doomModInfo a {
    color: #E8A33D;
    text-decoration: underline;
    font-weight: bold;
}
QTextEdit#doomModInfo b, QPlainTextEdit#doomModInfo b {
    font-weight: bold;
    color: #FFFFFF;
}
QTextEdit#doomModInfo u, QPlainTextEdit#doomModInfo u {
    text-decoration: underline;
    color: #F0D9C8;
}
QTextEdit#doomModInfo .doom-section, QPlainTextEdit#doomModInfo .doom-section {
    font-weight: bold;
    color: #FFE9DC;
    text-decoration: underline;
}

QToolTip {
    background: #241E26;
    color: #E9E1D6;
    border: 1px solid #C43B1D;
    border-radius: 3px;
    padding: 4px 6px;
    font-family: "Iosevka Nerd Font Mono", "JetBrains Mono", "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 10pt;
}

*:focus { outline: none; }
