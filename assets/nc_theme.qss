/* ===== UNIVERSAL 90s DOS/DOOM RETRO THEME ===== */

/* All widgets: dark blue, yellow text, chunky font */
QWidget {
    background-color: #000080;
    color: #FFFF00;
    font-family: "Fixedsys", "Terminal", "Courier New", monospace;
    font-size: 11pt;
}

/* Inputs, lists, plain text: slightly deeper blue, gold border */
QLineEdit, QListWidget, QTreeWidget, QPlainTextEdit, QComboBox {
    background-color: #000040;
    color: #FFFF00;
    border: 2px solid #FFFF00;
    padding: 4px;
    selection-background-color: #800000;
    selection-color: #FFFF00;
    font-size: 10pt;
}

QComboBox::drop-down {
    border-left: 2px solid #FFFF00;
    width: 24px;
    background: #800000;
}
QComboBox QAbstractItemView {
    background: #000040;
    color: #FFFF00;
    border: 2px solid #FFFF00;
    selection-background-color: #800000;
}

/* List widgets: better item spacing */
QListWidget {
    alternate-background-color: #000050;
    outline: none;
}

/* Tree views need every palette role defined explicitly. Without an
   AlternateBase color, desktop themes commonly inject a white row while the
   DOS-yellow foreground remains active. */
QTreeWidget {
    background-color: #00002B;
    alternate-background-color: #00243A;
    color: #FFF7A8;
    selection-background-color: #780000;
    selection-color: #FFFFFF;
    border: 2px solid #FFD800;
    outline: none;
}
QTreeWidget::item {
    color: #FFF7A8;
    border-bottom: 1px solid #25255F;
    padding: 4px 6px;
    min-height: 20px;
}
QTreeWidget::item:hover:!selected {
    background-color: #00456A;
    color: #FFFFFF;
    border-bottom-color: #00B8D8;
}
QTreeWidget::item:selected:active {
    background-color: #780000;
    color: #FFFFFF;
    border-top: 1px solid #FFD800;
    border-bottom: 1px solid #FFD800;
}
QTreeWidget::item:selected:!active {
    background-color: #54164F;
    color: #FFFFFF;
    border-top: 1px solid #B8A0C8;
    border-bottom: 1px solid #B8A0C8;
}
QTreeWidget:disabled {
    background-color: #111128;
    alternate-background-color: #181832;
    color: #8F8F72;
    border-color: #68684E;
}
QTreeWidget::item:disabled {
    color: #8F8F72;
}

/* Search and library rows are the primary reading surfaces. */
QTreeWidget#downloadResults, QTreeWidget#modLibrary {
    background-color: #00002B;
    alternate-background-color: #00243A;
    color: #FFF7A8;
    font-size: 10pt;
}
QListWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #333366;
    min-height: 18px;
}
QListWidget::item:selected {
    background-color: #800000;
    color: #FFFF00;
    border: 1px solid #FFFF00;
}
QListWidget::item:hover {
    background-color: #000060;
    color: #FFFFFF;
}

/* Classic buttons with better sizing */
QPushButton {
    background-color: #000040;
    color: #FFFF00;
    border: 2px outset #FFFF00;
    padding: 6px 12px;
    margin: 2px;
    min-height: 20px;
    font-weight: bold;
}
QPushButton:pressed {
    background-color: #800000;
    border: 2px inset #FFFF00;
}
QPushButton:hover {
    background-color: #000060;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #202050;
    color: #77775A;
    border-color: #66664A;
}
QPushButton#primaryButton {
    background-color: #006000;
    color: #FFFFFF;
    border: 3px outset #FFFF00;
}
QPushButton#primaryButton:hover {
    background-color: #008000;
}
QPushButton#dangerButton {
    background-color: #600000;
    color: #FFFF80;
}

/* Launch button: EVIL 90s DOOM styling */
QPushButton#launchButton {
    background-color: #800000;
    color: #FFFF00;
    border: 4px outset #FFFF00;
    padding: 10px 20px;
    font-family: "Fixedsys", "Terminal", "Courier New", monospace;
    font-size: 14pt;
    font-weight: bold;
    min-height: 35px;
    /* Subtle gradient for that 90s 3D effect */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #A00000, stop:0.5 #800000, stop:1 #600000);
}
QPushButton#launchButton:pressed {
    background-color: #600000;
    border: 4px inset #FFFF00;
    /* Inverted gradient when pressed */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #600000, stop:0.5 #800000, stop:1 #A00000);
}
QPushButton#launchButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #C00000, stop:0.5 #A00000, stop:1 #800000);
    color: #FFFFFF;
}

/* Menu bar/menus: DOS style */
QMenuBar, QMenu {
    background-color: #000080;
    color: #FFFF00;
    border: 1px solid #FFFF00;
}
QMenu::item:selected {
    background-color: #800000;
    color: #FFFF00;
    border: 1px solid #FFFF00;
}

QTabWidget::pane {
    border: 2px solid #FFFF00;
    background: #000050;
}
QTabBar::tab {
    background: #000040;
    color: #FFFF00;
    border: 2px outset #FFFF00;
    padding: 7px 14px;
    min-width: 90px;
    font-weight: bold;
}
QTabBar::tab:selected {
    background: #800000;
    color: #FFFFFF;
    border-style: inset;
}

QSplitter::handle {
    background: #FFFF00;
    border: 2px solid #000040;
    width: 7px;
    height: 7px;
}

/* Table/list headers */
QHeaderView::section {
    background-color: #00105A;
    color: #FFFFFF;
    border: 1px solid #FFD800;
    font-weight: bold;
    padding: 4px 6px;
}
QTableCornerButton::section {
    background-color: #00105A;
    border: 1px solid #FFD800;
}

/* Progress bar: red fill */
QProgressBar {
    background-color: #000040;
    color: #FFFF00;
    border: 2px solid #FFFF00;
    border-radius: 4px;
    text-align: center;
    height: 22px;
}
QProgressBar::chunk {
    background-color: #800000;
    width: 16px;
    margin: 0.5px;
}

/* Scrollbars: yellow frame, red handle with better contrast */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #000040;
    border: 2px solid #FFFF00;
    width: 16px;
    margin: 16px 0 16px 0;
}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #A00000;              /* Brighter red for better visibility */
    border: 1px solid #FFFF00;       /* Yellow border on handle */
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:hover {
    background: #C00000;              /* Even brighter on hover */
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: #000060;
    border: 1px solid #FFFF00;
    height: 16px;
}
QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::left-arrow, QScrollBar::right-arrow {
    width: 14px;
    height: 14px;
    background: #000060;
    border: none;
}

/* Special scrollbar styling for mod info */
QPlainTextEdit#doomModInfo QScrollBar:vertical {
    background: #400000;              /* Darker red background */
    border: 2px solid #FFFF80;       /* Brighter yellow border */
}
QPlainTextEdit#doomModInfo QScrollBar::handle:vertical {
    background: #FFFF00;              /* Yellow handle for high contrast */
    border: 1px solid #800000;       /* Red border */
}
QPlainTextEdit#doomModInfo QScrollBar::handle:hover {
    background: #FFFFFF;              /* White on hover */
}

/* Selection color for lists. Trees use the richer state palette above. */
QListWidget::item:selected {
    background-color: #800000;
    color: #FFFF00;
}

/* Main window: improved CRT gradient with better contrast */
QMainWindow {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                      stop:0 #1a0040, stop:0.5 #000080, stop:1 #000020);
    border: 2px solid #FFFF00;
}

/* Central widget: transparent to show main window gradient */
QMainWindow > QWidget {
    background: transparent;
}

QLabel#terminalTitle {
    background: #800000;
    color: #FFFFFF;
    border: 3px outset #FFFF00;
    padding: 7px;
    font-size: 12pt;
    font-weight: bold;
}
QLabel#mutedHint {
    color: #B8B86A;
    font-size: 9pt;
    padding: 2px;
}
QLabel#readinessStrip {
    background: #600000;
    color: #FFFF80;
    border: 2px inset #FFFF00;
    padding: 6px;
    font-weight: bold;
}
QLabel#readinessStrip[ready="true"] {
    background: #005000;
    color: #FFFFFF;
}
QLabel#modCount {
    background: #000040;
    border: 1px solid #FFFF00;
    padding: 5px 8px;
    font-weight: bold;
}
QLabel#selectionBanner {
    background: #000040;
    color: #B8B86A;
    border: 2px inset #77774A;
    padding: 6px 8px;
    font-weight: bold;
}
QLabel#selectionBanner[active="true"] {
    background: #005000;
    color: #FFFFFF;
    border: 2px solid #FFFF00;
}
QPlainTextEdit#browserPreview {
    background: #080820;
    color: #E8E8A0;
    border: 2px inset #FFFF00;
    padding: 8px;
    font-size: 9pt;
}
QScrollArea {
    background: #000050;
    border: none;
}
QStatusBar {
    background: #000040;
    color: #FFFFFF;
    border-top: 2px solid #FFFF00;
    padding: 3px;
}

/* LOST SOUL: "bloody" hell effect */
QWidget#bloodyContainer {
    background: #a00000;
    border: 6px solid #FF2222;
    border-radius: 16px;
    /* box-shadow: 0 0 30px 8px #FF2222; */
}

/* LOST SOUL GIF LABEL: no border, no extra space */
QLabel#lostSoul {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

/* Lost Soul Window dialog: thick gold frame */
QDialog#lostSoulWindow {
    background-color: #000040;
    border: 4px solid #FFFF00;
    border-radius: 12px;
    padding: 18px;
}

/* Lost Soul progress chunk: DOOM red */
QDialog#lostSoulWindow QProgressBar::chunk {
    background-color: #800000;
}

/* Group boxes: blocky, gold frame with better spacing and responsiveness */
QGroupBox {
    border: 2px solid #FFFF00;
    margin-top: 12px;
    margin-bottom: 6px;
    background: rgba(0, 0, 96, 180);
    color: #FFFF00;
    font-weight: bold;
    font-size: 10pt;
    padding-top: 12px;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 3px 10px 3px 10px;
    background: #000080;
    border: 1px solid #FFFF00;
    border-radius: 3px;
    left: 10px;
    top: -8px;
    font-size: 9pt;
}

/* Mod Info: DOOM shareware warning style with improved contrast! */
QTextEdit#doomModInfo, QPlainTextEdit#doomModInfo {
    background-color: #800000;         /* Darker DOOM red for better contrast */
    color: #FFFF80;                    /* Brighter yellow text */
    font-family: "Consolas", "Liberation Mono", "Courier New", monospace;
    font-size: 11pt;
    font-weight: bold;                 /* Bold for better readability */
    border: 3px solid #FFFF00;        /* Yellow border */
    border-radius: 0px;
    padding: 12px;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
    line-height: 1.3;                  /* Better line spacing */
    /* CRT-style text shadow for authentic retro feel */
}

/* Blue links/highlights in Mod Info (QTextEdit only) */
QTextEdit#doomModInfo a {
    color: #88CCFF;                    /* Brighter blue for better contrast */
    text-decoration: underline;
    font-weight: bold;
}

QTextEdit#doomModInfo b, QPlainTextEdit#doomModInfo b {
    font-weight: bold;
    color: #FFFFFF;                    /* Pure white for bold text */
}

QTextEdit#doomModInfo u, QPlainTextEdit#doomModInfo u {
    text-decoration: underline;
    color: #FFFF80;
}

QTextEdit#doomModInfo .doom-section, QPlainTextEdit#doomModInfo .doom-section {
    font-weight: bold;
    color: #FFFFFF;                    /* Pure white for sections */
    text-decoration: underline;
}

/* Tooltip: red/yellow */
QToolTip {
    background: #800000;
    color: #FFFF00;
    border: 2px solid #FFFF00;
    font-family: "Fixedsys", "Terminal", "Courier New", monospace;
    font-size: 10pt;
}

/* Remove focus rectangles for pure DOS */
*:focus {
    outline: none;
}

/* ===== END ===== */
